# Скопируйте этот файл в .env для локальной разработки (python-dotenv подхватит его сам).
# На Render эти же переменные задаются в Dashboard -> Environment, .env туда не заливается.

# Токен бота из @BotFather. СТАРЫЙ ТОКЕН (8898935141:...) БЫЛ В КОДЕ И УЖЕ ПОПАЛ
# В ПУБЛИЧНЫЙ РЕПОЗИТОРИЙ НА GITHUB — отзовите его через /revoke в @BotFather
# и впишите сюда новый, прежде чем деплоить эту версию.
BOT_TOKEN=

# Ваш Telegram id (не username!) — куда бот будет слать уведомления о новых заявках
# на проверку и куда придут админ-команды /pending /approve_ID /reject_ID.
# Узнать свой id можно, например, у бота @userinfobot.
ADMIN_TELEGRAM_ID=

# Публичный URL фронтенда (frontend-tma), который откроется по кнопке в боте.
WEBAPP_URL=https://frontend-tma-2w9i.onrender.com

# Секрет для проверки вебхуков Telegram — придумайте случайную строку и укажите
# тот же секрет при регистрации вебхука (параметр secret_token в setWebhook).
# Без него теоретически можно подделать успешный платёж и получить PRO бесплатно.
WEBHOOK_SECRET=

# Список разрешённых доменов для CORS через запятую. Пока фронтенд один — можно
# оставить просто его адрес.
ALLOWED_ORIGINS=https://frontend-tma-2w9i.onrender.com

# DEV_MODE=true включает тестового пользователя (id 12345678), если запрос пришёл
# совсем без данных авторизации Telegram — удобно для локальной разработки в браузере.
# НА PRODUCTION (Render) ЭТО ДОЛЖНО БЫТЬ false ИЛИ ВООБЩЕ НЕ ЗАДАНО.
DEV_MODE=false

# Строка подключения к базе. Если не задано — используется локальный SQLite-файл.
# На Render для настоящего продакшена лучше подключить PostgreSQL (Render Postgres)
# вместо SQLite — SQLite на бесплатном тарифе Render не переживёт перезапуск контейнера.
DATABASE_URL=
